# =========================================================================
# Makefile para PlayStation 2 (ps2dev) - libnes.a
# =========================================================================

OBJ_DIR = obj_ps2
TARGET_DIR = lib/ps2
LIB     = $(TARGET_DIR)/libnes.a

CC      = $(EE_CC)
CXX     = $(EE_CXX)
AR      = $(EE_AR)
RANLIB  = ee-ranlib

# Configuración de compilación para PS2
PS2_ARCH = $(EE_CFLAGS) $(EE_INCS) 
CFLAGS   = $(PS2_ARCH) -O2 -fomit-frame-pointer 
CXXFLAGS = $(PS2_ARCH) -O2 -fomit-frame-pointer -fno-exceptions 

# --- 1. Detección de todos los archivos en src/ ---
ALL_C   = $(wildcard src/*.c)
ALL_CPP = $(wildcard src/*.cpp)
ALL_S   = $(wildcard src/*.S)

# --- 2. LISTA DE EXCLUSIÓN COMPLETA ---
# Añadimos src/nsf.cpp para saltar el error de tipos del APU, tal como en tu original
EXCLUDE_SOURCES = src/nes_exsound.cpp src/nes_vrc6.cpp src/nes_vrc7.cpp \
                  src/nes_fds.cpp src/nes_mmc5.cpp src/nes_n106.cpp \
                  src/nes_fme7.cpp src/render_bg.cpp src/render_tile.cpp \
                  src/render_spr.cpp src/render_spr_tile.cpp src/do_scanline.cpp \
                  src/nes_emulate_frame.cpp src/nes_rom_correct.cpp \
                  src/nes_set_controller.cpp src/nes_pad_command.cpp src/nes_pad_state.cpp \
                  src/nes_set_cycles.cpp src/nes_get_cycles.cpp \
                  src/nsf.cpp

# --- 3. Filtrar los archivos principales ---
SOURCES_C   = $(filter-out $(EXCLUDE_SOURCES), $(ALL_C))
SOURCES_CPP = $(filter-out $(EXCLUDE_SOURCES), $(ALL_CPP))
SOURCES_S   = $(filter-out $(EXCLUDE_SOURCES), $(ALL_S))

# Mapeo final a la carpeta obj_ps2/
OBJS = $(patsubst src/%.c, $(OBJ_DIR)/%.o, $(SOURCES_C)) \
       $(patsubst src/%.cpp, $(OBJ_DIR)/%.o, $(SOURCES_CPP)) \
       $(patsubst src/%.S, $(OBJ_DIR)/%.o, $(SOURCES_S))

# --- Reglas Principales ---

all: $(LIB)

$(LIB): $(OBJS)
	mkdir -p $(TARGET_DIR)
	$(AR) -cru $@ $(OBJS)
	$(RANLIB) $@
	@echo "=== ¡Librería PS2 guardada en $@! ==="

# Compilación de objetos individuales
$(OBJ_DIR)/%.o: src/%.c
	mkdir -p $(OBJ_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJ_DIR)/%.o: src/%.cpp
	mkdir -p $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(OBJ_DIR)/%.o: src/%.S
	mkdir -p $(OBJ_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -rf $(OBJ_DIR)
	rm -rf lib/ps2
	@echo "Limpieza de PS2 completada."

include $(PS2SDK)/samples/Makefile.pref
include $(PS2SDK)/samples/Makefile.eeglobal